# Copy this file to server/.env for local settings. All lines are optional locally.

# Use your hosted Neon database from your laptop (e.g. to run `npm run seed:demo` on it).
# Leave it out to use the built-in local database in server/data.
# DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# JWT_SECRET=any-long-random-text
# STAFF_PASSWORD=first-password-for-staff-accounts
